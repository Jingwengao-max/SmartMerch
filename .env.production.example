# One OpenAI-compatible vision model. Configure these in Railway Variables.
AI_API_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
AI_API_KEY=replace-with-your-server-side-key
AI_MODEL=qwen3-vl-plus

# Supabase server-side metadata persistence. Never expose the secret key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace-with-your-server-key

# Railway volume mount path. The Docker image already defaults to /data.
SMARTMERCH_RUNTIME_DIR=/data
