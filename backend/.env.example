# 复制本文件为 .env 并填写真实值即可，后端启动时会自动读取。
# 外部已经设置的环境变量优先，不会被这里的值覆盖；.env 已被 .gitignore 忽略。

# OpenAI 兼容的视觉模型接口。URL 可以填 /v1 根地址或完整的 /chat/completions 地址。
AI_API_URL=https://example.com/v1
AI_API_KEY=replace-with-your-key
AI_MODEL=qwen3-vl-plus

# 可选：单次请求超时（秒）与送模型前的图片最长边。
AI_TIMEOUT=120
AI_IMAGE_MAX_EDGE=1024

# 可选：独立的 PosterCraft 兼容背景服务。
POSTERCRAFT_URL=
